+// Isolated software-QA navigation only; never evidence of walking reachability.
+export const TEXTILE_NEAR_ENTITY76='cabins:-1743,3612:30f9adc9fb584805';
+export const TEXTILE_NEAR_ID76='software-qa-textile-near76';
+export const TEXTILE_NEAR_LABEL76='软件QA · 箱上织物近景（仅静态观察，不证明步行可达）';
+export const TEXTILE_SIDE_ID76='software-qa-textile-side76';
+export const TEXTILE_SIDE_LABEL76='软件QA · 箱上织物左斜侧（低机位静态观察，不证明步行可达）';
+export function textileNearReviewPlaces76(world,{enabled=false}={}){
+ if(enabled!==true)return [];
+ const matches=world?.entities?.filter(e=>e.id===TEXTILE_NEAR_ENTITY76);
+ if(matches?.length!==1||matches[0].assetId!=='house_a'||matches[0].part)throw Error('Textile near QA requires one complete representative house_a');
+ const pose=world.surface?.buildingPose?.(matches[0]);
+ if(!pose||![pose.x,pose.y,pose.z,pose.rot,pose.scale?.x,pose.scale?.y,pose.scale?.z].every(Number.isFinite)||[pose.scale.x,pose.scale.y,pose.scale.z].some(v=>v<=0))throw Error('Textile near QA invalid building pose');
+ const transform=([x,y,z])=>{const c=Math.cos(pose.rot),s=Math.sin(pose.rot);x*=pose.scale.x;z*=pose.scale.z;return [pose.x+c*x+s*z,pose.y+y*pose.scale.y,pose.z-s*x+c*z];};
+ const presets=[
+  {id:TEXTILE_NEAR_ID76,name:TEXTILE_NEAR_LABEL76,localPosition:[.95,1.60,-.90],localTarget:[.95,.88,-1.98]},
+  {id:TEXTILE_SIDE_ID76,name:TEXTILE_SIDE_LABEL76,localPosition:[-.45,1.18,-1.70],localTarget:[.85,.82,-1.98]},
+ ];
+ return presets.map(({id,name,localPosition,localTarget})=>{
+ const position=transform(localPosition),target=transform(localTarget);
+ if(![...position,...target].every(Number.isFinite))throw Error('Textile near QA nonfinite transformed pose');
+ const [dx,dy,dz]=target.map((v,i)=>v-position[i]),horizontal=Math.hypot(dx,dz);
+ if(!(horizontal>0))throw Error('Textile near QA degenerate look direction');
+ const yaw=Math.atan2(dx,-dz)*180/Math.PI,pitch=Math.atan2(dy,horizontal)*180/Math.PI;
+ return {id,name,category:'软件QA · 静态观察',entityId:TEXTILE_NEAR_ENTITY76,assetId:'house_a',x:position[0],y:position[1],z:position[2],yaw,pitch,softwareQAOnly:true,qaNavigation:{version:76,scope:'static-camera-teleport-not-walking-or-physics-acceptance',localPosition,localTarget,worldTarget:target,targetDistance:Math.hypot(dx,dy,dz)}};
+ });
+}
+export function textileNearNavigationAllowed76(place,review){
+ return !place?.softwareQAOnly||Boolean(review&&!review.closed&&review.phase==='held'&&!review.pending&&!review.reservation);
+}
